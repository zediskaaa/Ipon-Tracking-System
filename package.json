{
  "name": "ipon-tracking-system",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "db:status": "node scripts/supabase-migrate.mjs --status",
    "db:migrate": "node scripts/supabase-migrate.mjs --apply",
    "supabase:deploy": "node scripts/supabase-migrate.mjs --apply --deploy-functions --force",
    "supabase:sync": "node scripts/supabase-migrate.mjs --sync",
    "supabase:watch": "node scripts/supabase-migrate.mjs --sync --watch",
    "mobile:prepare": "node scripts/prepare-mobile.mjs",
    "mobile:sync": "node scripts/prepare-mobile.mjs && npx cap sync"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/local-notifications": "^8.3.1"
  }
}
